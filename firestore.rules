rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica se o usuário autenticado é admin NO CLÃ especificado
    function isClanAdmin(clanSlug) {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/clans/$(clanSlug)/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Verifica se o usuário pertence ao clã (tem documento na subcoleção)
    function isClanMember(clanSlug) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/clans/$(clanSlug)/users/$(request.auth.uid));
    }

    // ─── Clans (config white-label) ───────────────────────────────────────────
    // Leitura pública — necessário para carregar o tema antes do login
    match /clans/{clanSlug} {
      allow read: if true;
      // Escrita apenas por admin do próprio clã
      allow write: if isClanAdmin(clanSlug);
    }

    // ─── Dados scoped por clã ─────────────────────────────────────────────────
    match /clans/{clanSlug}/users/{userId} {
      // Membros do clã podem ler outros membros
      allow read: if isClanMember(clanSlug);
      // Apenas o próprio usuário ou admin do clã pode escrever
      allow write: if isAuthenticated() &&
                      (request.auth.uid == userId || isClanAdmin(clanSlug));
      // Qualquer pessoa autenticada pode criar (registro)
      allow create: if isAuthenticated();
    }

    match /clans/{clanSlug}/events/{eventId} {
      allow read: if isClanMember(clanSlug);
      allow write: if isClanAdmin(clanSlug);
    }

    match /clans/{clanSlug}/eventVotes/{voteId} {
      allow read: if isClanMember(clanSlug);
      allow create: if isClanMember(clanSlug);
      allow update: if isClanMember(clanSlug) &&
                       (request.auth.uid == resource.data.userId || isClanAdmin(clanSlug));
      allow delete: if isClanMember(clanSlug) &&
                       request.auth.uid == resource.data.userId;
    }

    match /clans/{clanSlug}/attendances/{attendanceId} {
      allow read: if isClanMember(clanSlug);
      allow create: if isClanMember(clanSlug);
      allow update, delete: if isClanAdmin(clanSlug);
    }

    match /clans/{clanSlug}/raffles/{raffleId} {
      allow read: if isClanMember(clanSlug);
      allow create, delete: if isClanAdmin(clanSlug);
      allow update: if isClanMember(clanSlug);
    }

    match /clans/{clanSlug}/notifications/{notifId} {
      allow read: if isClanMember(clanSlug) &&
                     request.auth.uid == resource.data.userId;
      allow update: if isClanMember(clanSlug) &&
                       request.auth.uid == resource.data.userId;
      allow create: if isClanMember(clanSlug);
      allow delete: if isClanAdmin(clanSlug);
    }

    match /clans/{clanSlug}/items/{itemId} {
      allow read: if isClanMember(clanSlug);
      allow write: if isClanAdmin(clanSlug);
    }

    match /clans/{clanSlug}/redemptions/{redemptionId} {
      allow read: if isClanMember(clanSlug);
      allow create: if isClanMember(clanSlug);
      allow update, delete: if isClanAdmin(clanSlug);
    }
  }
}
