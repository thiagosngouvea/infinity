rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Logos dos clãs — leitura pública, escrita apenas autenticado
    // (a verificação de admin é feita no app; Storage não tem acesso ao Firestore)
    match /clans/{clanSlug}/logo {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024  // max 5MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Regra padrão: bloquear tudo que não foi explicitamente permitido
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
