rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/super_admins/$(request.auth.uid));
    }

    function isClanAdmin(clanSlug) {
      return isAuthenticated()
        && firestore.get(/databases/(default)/documents/clans/$(clanSlug)/users/$(request.auth.uid)).data.role
          in ['admin', 'super_admin'];
    }

    function isClanMember(clanSlug) {
      return isAuthenticated()
        && firestore.get(/databases/(default)/documents/clans/$(clanSlug)/users/$(request.auth.uid)).data.role
          in ['member', 'admin', 'super_admin'];
    }

    function isImageUnder(maxBytes) {
      return request.resource.size < maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    match /clans/{clanSlug}/logo {
      allow read: if true;
      allow create, update: if (isSuperAdmin() || isClanAdmin(clanSlug))
        && isImageUnder(5 * 1024 * 1024);
      allow delete: if isSuperAdmin() || isClanAdmin(clanSlug);
    }

    match /clans/{clanSlug}/tutorials/{fileName} {
      allow read: if isSuperAdmin() || isClanMember(clanSlug);
      allow create, update: if (isSuperAdmin() || isClanAdmin(clanSlug))
        && ((request.resource.contentType == 'application/pdf'
            && request.resource.size < 20 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*')
            && request.resource.size < 200 * 1024 * 1024));
      allow delete: if isSuperAdmin() || isClanAdmin(clanSlug);
    }

    match /clans/{clanSlug}/events/{eventId}/banner {
      allow read: if true;
      allow create, update: if (isSuperAdmin() || isClanAdmin(clanSlug))
        && isImageUnder(10 * 1024 * 1024);
      allow delete: if isSuperAdmin() || isClanAdmin(clanSlug);
    }

    match /clans/{clanSlug}/images/{fileName} {
      allow read: if true;
      allow create, update: if (isSuperAdmin() || isClanAdmin(clanSlug))
        && isImageUnder(10 * 1024 * 1024);
      allow delete: if isSuperAdmin() || isClanAdmin(clanSlug);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
